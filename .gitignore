# Node.js
webui-src/node_modules/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# Release and update staging
dist/SHA256SUMS
dist/*.tar.gz
src/sysroot/usr/local/bin/tailscale*

# Private deployment configuration, logs, and identity files
.env
.env.*
*.state
*.log
*.log*.txt
*.key
updater.conf
